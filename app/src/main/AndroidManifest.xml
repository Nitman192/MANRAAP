<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_brain"
        android:label="Permanent Learning"
        android:roundIcon="@drawable/ic_brain"
        android:supportsRtl="true"
        android:theme="@style/Theme.PermanentLearning">

        <activity android:name=".ui.progress.ProgressActivity" />
        <activity android:name=".ui.recall.RecallActivity" />
        <activity android:name=".ui.detail.TopicDetailActivity" />
        <activity android:name=".ui.topic.AddEditTopicActivity" />
        <activity
            android:name=".ui.home.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>

</manifest>
